# Copy to server/.env and adjust. Every variable is optional in development.

# Leave DATABASE_URL unset to use the embedded PGlite database in server/.data/pglite.
# Set it to use a real Postgres (e.g. the one from docker-compose.yml):
# DATABASE_URL=postgres://crm:crm@localhost:5432/crm

PORT=4000
HOST=127.0.0.1
# Origins allowed to call the API with cookies (comma-separated).
WEB_ORIGIN=http://localhost:8443,http://localhost:8444
LOG_LEVEL=info

# Public URL of the web app; used in invite and password-reset links.
APP_URL=http://localhost:8443
# How long a sign-in lasts (sliding: renewed while in use).
SESSION_TTL_DAYS=30

# Password given to every seeded user (dev/test only). Defaults to the value in scripts/seed.ts.
# SEED_PASSWORD=
# Absolute session lifetime (a session ends this long after sign-in, even if used daily).
SESSION_MAX_DAYS=90

# Reverse proxies allowed to set X-Forwarded-For. "false" = none, a number = hop count,
# or IPs/CIDRs. Production default: 127.0.0.1 (Nginx/Caddy on the same host).
# Never "true" on a public port: clients could spoof their IP and dodge rate limits.
# TRUST_PROXY=127.0.0.1

# Uploaded documents (back this folder up together with the database).
# STORAGE_DIR=/var/lib/northstar-crm/uploads
MAX_UPLOAD_MB=25

# Reminder + clean-up jobs run inside the API process (VPS). A database lock makes sure only
# one instance runs them per interval, so several instances are safe.
JOBS_ENABLED=true
JOBS_INTERVAL_MINUTES=15

# Max Postgres connections per API process (default 10; 3 on Vercel).
# DB_POOL_MAX=10

# ---- Vercel (see "Deploying to Vercel" in the README) ----
# Private Vercel Blob store for documents. When set, uploads go straight from the browser to
# Blob and downloads use short-lived links; STORAGE_DIR is not used. Added for you when you
# connect a Blob store to the Vercel project.
# BLOB_READ_WRITE_TOKEN=
# Secret Vercel Cron sends to GET /api/v1/cron/jobs (at least 16 characters). Unset = endpoint off.
# CRON_SECRET=
