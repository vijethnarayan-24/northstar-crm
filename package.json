{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "api": "pnpm --filter @crm/server dev",
    "db:migrate": "pnpm --filter @crm/server db:migrate",
    "db:seed": "pnpm --filter @crm/server db:seed",
    "db:reset": "pnpm --filter @crm/server db:reset",
    "db:generate": "pnpm --filter @crm/server db:generate",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/blob": "2.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
